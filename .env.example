# Copy to .env and adjust as needed.

# Meilisearch
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=masterKey

# Neo4j (optional; used by existing scraper pipeline)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# DIP (Bundestag) API
# Get an API key for https://search.dip.bundestag.de/api/v1/
DIP_BASE_URL=https://search.dip.bundestag.de/api/v1
DIP_API_KEY=
DIP_MAX_WAHLPERIODE=50

# LangGraph MVP (optional)
PISS_TOOL_BASE_URL=http://localhost:8000/api/tools
PISS_OLLAMA_BASE_URL=http://localhost:11434/v1
PISS_OLLAMA_MODEL=ministral-3:14b
PISS_OPENAI_API_KEY=ollama
PISS_STRICT_EVIDENCE_DEFAULT=true
PISS_DEBUG=0

